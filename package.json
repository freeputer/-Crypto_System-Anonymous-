{
  "name": "eth-wallet-desktop",
  "version": "1.0.0",
  "description": "TRC20 波场代币钱包桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "npx electron .",
    "build": "npx electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "tronweb": "^5.3.5"
  },
  "build": {
    "appId": "com.example.ethwallet",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "deb"
    }
  }
}
